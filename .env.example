# ==============================================================================
# KEYWORD STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in optional API credentials as needed.
# NOTE: All integrations are OPTIONAL. Keyword Studio operates 100% locally
# out of the box using public Google Suggest autocomplete and deterministic heuristics.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YouTube Data API v3 (Optional)
# ------------------------------------------------------------------------------
# Purpose: Enables live competitor video metrics, top video view counts, and published dates.
# Fallback: When omitted, Keyword Studio activates UnconnectedSerpMetricsProvider
#           with zero synthetic metrics and honest fallback in-app guidance.
# Where to get: Google Cloud Console -> APIs & Services -> Credentials -> Create API Key
# Cost: Free tier allows 10,000 quota units/day.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Optional)
# ------------------------------------------------------------------------------
# Purpose: Powers advanced AI product descriptions and script hook suggestions.
# Fallback: When omitted, Keyword Studio uses built-in rule-based description templates.
# Where to get: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OpenAI API (Optional)
# ------------------------------------------------------------------------------
# Purpose: Alternative LLM provider for AI product intelligence and script synthesis.
# Fallback: When omitted, built-in deterministic templates generate all briefs.
# Where to get: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Streamlit Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Default port is 8501. Set custom port if 8501 is occupied.
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
